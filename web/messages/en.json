{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "of_total": "of {total}",
  "answer_single": "One answer",
  "answer_multi": "Several answers",
  "keys_or": "or",
  "keys_choose": "pick an answer,",
  "keys_next": "moves on",
  "progress_label": "Progress",
  "progress_value": "{answered} of {total} answered",
  "progress_question_answered": "Question {number}, answered",
  "progress_question_open": "Question {number}, not answered",
  "progress_all": "All questions",
  "finish_title": "Test finished",
  "finish_grade": "Grade {grade} of 12",
  "finish_correct": "Correct: {correct} of {total}",
  "finish_sent": "Result sent to the teacher",
  "finish_waiting": "Your work is saved. The grade will appear once the connection is back",
  "toast_offline": "No connection. Your answers are saved",
  "toast_offline_pending": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "{count} answer is kept on this computer and will be sent once the connection is back",
        "countPlural=*": "{count} answers are kept on this computer and will be sent once the connection is back"
      }
    }
  ],
  "toast_offline_none": "New answers will be kept on this computer too",
  "toast_syncing": "Sending your answers…",
  "toast_syncing_pending": "{count} left",
  "toast_online": "Connection restored",
  "toast_all_sent": "All answers sent"
}
