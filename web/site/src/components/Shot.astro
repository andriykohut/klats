---
import { Image } from "astro:assets";
import { type Lang, type ShotName, strings } from "../i18n";
import { findShot } from "../shots";

interface Props {
  lang: Lang;
  name: ShotName;
  /** Loads at once instead of near the viewport; for the first screen. */
  eager?: boolean;
}

const { lang, name, eager } = Astro.props;
const src = findShot(lang, name);
if (!src) {
  throw new Error(`missing screenshot src/assets/shots/${lang}/${name}.png`);
}
---

<Image
  class="shot"
  src={src}
  alt={strings[lang].shots[name]}
  loading={eager ? "eager" : "lazy"}
/>
