---
import { getRelativeLocaleUrl } from "astro:i18n";
import { type Lang, strings } from "../i18n";

interface Props {
  lang: Lang;
  /** The current page, as Page takes it; the language link points at it. */
  page: string;
}

const { lang, page } = Astro.props;
const t = strings[lang];
const other: Lang = lang === "uk" ? "en" : "uk";
const current = (p: string) => (p === page ? "page" : undefined);
---

<header>
  <div class="wrap">
    <a class="logo" href={getRelativeLocaleUrl(lang)}>
      <img src={`${import.meta.env.BASE_URL}/favicon.svg`} alt="" width="30" height="30" />
      {t.name}
    </a>
    <nav>
      <a href={getRelativeLocaleUrl(lang, "install")} aria-current={current("install")}>{t.nav.install}</a>
      <a href={getRelativeLocaleUrl(lang, "faq")} aria-current={current("faq")}>{t.nav.help}</a>
      <a href={getRelativeLocaleUrl(other, page)} lang={other} hreflang={other}>{t.nav.other}</a>
    </nav>
  </div>
</header>

<style>
  header {
    background: var(--teal);
    color: #fff;
  }

  .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding-top: 14px;
    padding-bottom: 14px;
    font-size: 16px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover,
  a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 600 20px var(--display);
  }

  img {
    border-radius: 8px;
  }

  nav {
    margin-left: auto;
    display: flex;
    gap: 24px;
    opacity: 0.9;
  }

  @media (max-width: 760px) {
    .wrap {
      gap: 8px 16px;
      font-size: 15px;
    }

    nav {
      gap: 16px;
    }
  }
</style>
