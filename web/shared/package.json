{
  "name": "@klats/shared",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "build": "pnpm i18n",
    "i18n": "paraglide-js compile --project ../messages/project.inlang --outdir ./src/paraglide",
    "test": "vitest run",
    "typecheck": "pnpm i18n && tsc --noEmit"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "motion": "14.12.0",
    "react-aria-components": "1.22.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
