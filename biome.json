{
  "formatter": { "enabled": true, "indentStyle": "space" },
  "linter": { "enabled": true },
  "files": {
    "includes": [
      "web/**",
      "!**/dist",
      "!**/node_modules",
      "!**/paraglide",
      "!**/project.inlang",
      "!**/generated",
      "!**/test-results",
      "!**/.astro"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": { "useConst": "off", "useImportType": "off" },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
